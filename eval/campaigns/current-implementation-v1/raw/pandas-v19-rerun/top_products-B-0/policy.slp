tool compute {
  owner analyst
  grant analyst: call
  runs linux
  syscalls @minimal
  fs read ${sandbox_source} need, read /data/langgraph/eval/campaigns/current-implementation-v1/raw/pandas-v19-rerun/top_products-B-0/fixture/sales.csv need, read+write+create+delete+truncate /data/langgraph/eval/campaigns/current-implementation-v1/raw/pandas-v19-rerun/top_products-B-0/fixture/outputs/** need
  limits cpu 15s pids 1 nofile 64 wall 15s
}
principal alice {
  roles analyst
  fs read /data/slanggraph-eval-upstreams/ai-data-science-team/.venv/lib/python3.13/site-packages/**, read /data/langgraph/eval/campaigns/current-implementation-v1/raw/pandas-v19-rerun/top_products-B-0/fixture/sales.csv, read+write+create+delete+truncate /data/langgraph/eval/campaigns/current-implementation-v1/raw/pandas-v19-rerun/top_products-B-0/fixture/outputs/**
}
